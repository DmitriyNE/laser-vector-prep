{
  "schemaVersion": 1,
  "profileId": "builtin-pcb-positive-ldi",
  "name": "PCB positive LDI (contour fill)",
  "sourceBindings": [
    {
      "id": "src-copper",
      "name": "Copper",
      "required": true,
      "rules": [
        {
          "kind": "layerName",
          "format": "dxf",
          "name": "TOP_LAYER"
        },
        {
          "kind": "function",
          "pattern": "Copper,L1,Top"
        },
        {
          "kind": "function",
          "pattern": "CONDUCTOR,TOP"
        },
        {
          "kind": "fileName",
          "format": "gerber",
          "pattern": "*.gtl"
        },
        {
          "kind": "fileName",
          "format": "gerber",
          "pattern": "*-F_Cu.gbr"
        },
        {
          "kind": "fileName",
          "format": "gerber",
          "pattern": "*.cmp"
        }
      ]
    },
    {
      "id": "src-outline",
      "name": "Board outline",
      "required": false,
      "rules": [
        {
          "kind": "layerName",
          "format": "dxf",
          "name": "ROUTE_TOOL_PATH"
        },
        {
          "kind": "function",
          "pattern": "Profile*"
        },
        {
          "kind": "fileName",
          "format": "gerber",
          "pattern": "*.gko"
        },
        {
          "kind": "fileName",
          "format": "gerber",
          "pattern": "*.gm1"
        },
        {
          "kind": "fileName",
          "format": "gerber",
          "pattern": "*-Edge_Cuts.gbr"
        }
      ]
    }
  ],
  "workingLayers": [
    {
      "id": "wl-copper",
      "name": "Copper",
      "kind": "region",
      "inputs": [
        {
          "source": "src-copper"
        }
      ],
      "operands": [],
      "op": "union",
      "interpretation": {
        "loopRule": "mergeThenNest",
        "strokeWidth": "original"
      },
      "passes": [
        {
          "id": "pass-copper-fill",
          "name": "Contour fill 20 um",
          "pattern": {
            "kind": "contourFill",
            "pitchMm": 0.02,
            "gapFill": true
          },
          "group": "grp-copper",
          "enabled": true
        }
      ],
      "enabled": true,
      "referenceOnly": false
    },
    {
      "id": "wl-outline",
      "name": "Outline",
      "kind": "linework",
      "inputs": [
        {
          "source": "src-outline"
        }
      ],
      "operands": [],
      "op": "union",
      "interpretation": {
        "loopRule": "mergeThenNest",
        "strokeWidth": "original"
      },
      "passes": [
        {
          "id": "pass-outline",
          "name": "Outline passthrough",
          "pattern": {
            "kind": "passthrough",
            "reverse": false
          },
          "group": "grp-outline",
          "enabled": true
        }
      ],
      "enabled": true,
      "referenceOnly": false
    },
    {
      "id": "wl-artwork-box",
      "name": "Artwork box",
      "kind": "envelope",
      "inputs": [
        {
          "layer": "wl-copper"
        }
      ],
      "operands": [],
      "op": "union",
      "envelope": {
        "provider": "boundingBox",
        "marginMm": 1.0
      },
      "interpretation": {
        "loopRule": "mergeThenNest",
        "strokeWidth": "original"
      },
      "passes": [],
      "enabled": true,
      "referenceOnly": true
    },
    {
      "id": "wl-keep-clear",
      "name": "Keep clear (background)",
      "kind": "region",
      "inputs": [
        {
          "layer": "wl-artwork-box"
        }
      ],
      "operands": [
        {
          "layer": "wl-copper"
        }
      ],
      "op": "subtraction",
      "interpretation": {
        "loopRule": "mergeThenNest",
        "strokeWidth": "original"
      },
      "passes": [],
      "enabled": true,
      "referenceOnly": true
    }
  ],
  "outputGroups": [
    {
      "id": "grp-copper",
      "name": "Copper",
      "color": [
        0,
        0,
        255
      ],
      "export": true,
      "visible": true
    },
    {
      "id": "grp-outline",
      "name": "Outline",
      "color": [
        255,
        0,
        0
      ],
      "export": true,
      "visible": true
    }
  ],
  "export": {
    "strokeWidthMm": 0.0254,
    "marginMm": 5.0,
    "separateFiles": false,
    "flattenToleranceMm": 0.001
  },
  "optimizer": {
    "mode": "bleedAware",
    "footprintMm": 0.1,
    "bleedWeight": 1.0,
    "protected": [
      "wl-keep-clear"
    ],
    "cellMm": 0.05,
    "maxSweeps": 20
  }
}
